VITE_SUPABASE_URL=https://txabiyeodojnqsxmlzwe.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Supabase Project Connection String
# You can find your connection string in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# e.g., jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# Or connection pooling mode:
# e.g., jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

SPRING_DATASOURCE_URL=postgresql://postgres:K0b31sthegreat!@db.txabiyeodojnqsxmlzwe.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=K0b31sthegreat!
